# ============================================
# ORIGAMI — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git

# --- Supabase ---
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- DeepSeek AI ---
# Get this from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- GitHub OAuth ---
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:3000 (dev) / https://your-app.vercel.app (prod)
# Callback URL: http://localhost:3000/api/auth/callback (dev)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# --- LaTeXOnline (no key needed — free public API) ---
LATEX_ONLINE_URL=https://latexonline.cc/compile

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here
